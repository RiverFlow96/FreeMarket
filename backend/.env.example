# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.pages.dev,your-custom-domain.com

# Database (Supabase)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres?schema=public

# CORS
CORS_ALLOWED_ORIGINS=https://your-cloudflare-url.pages.dev,https://your-custom-domain.com

# Static & Media
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
